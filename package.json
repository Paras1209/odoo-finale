{
  "name": "dealflow360",
  "version": "1.0.0",
  "description": "DealFlow360 - Intelligent, Self-Governing Sales Operations Platform",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "db:migrate": "npm run db:migrate --workspace=frontend",
    "db:seed": "npm run db:seed --workspace=frontend",
    "db:studio": "npm run db:studio --workspace=frontend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

# ===========================================
# DealFlow360 Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/dealflow360?schema=public"

# JWT Secret for Internal Users (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# JWT Secret for Portal Customers (separate secret for security)
PORTAL_JWT_SECRET="your-portal-jwt-secret-change-in-production"
PORTAL_JWT_EXPIRES_IN="24h"

# Server Configuration
PORT=3001
NODE_ENV="development"

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000"

# Logging
LOG_LEVEL="debug"

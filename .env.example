# ===========================================
# DealFlow360 Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/dealflow360?schema=public"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Portal JWT (separate secret for customer portal)
PORTAL_JWT_SECRET="your-portal-jwt-secret-change-in-production"
PORTAL_JWT_EXPIRES_IN="24h"

# Backend Server
BACKEND_PORT=3001
BACKEND_URL="http://localhost:3001"

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000"

# Node Environment
NODE_ENV="development"
